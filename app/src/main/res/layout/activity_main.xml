<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اشتراک صفحه گوشی"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="نمایش و کنترل صفحه از طریق وای‌فای در مرورگر کروم"
            android:textColor="#8B93A4"
            android:textSize="14sp" />

        <!-- وضعیت اشتراک -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اشتراک متوقف است"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="آدرس را در کروم کامپیوتر باز کنید:"
                android:textColor="#8B93A4"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="left"
                android:text="—"
                android:textColor="#7FB0FF"
                android:textDirection="ltr"
                android:textIsSelectable="true"
                android:textSize="17sp" />

            <Button
                android:id="@+id/btnCopy"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_ghost"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="کپی آدرس"
                android:textColor="#E8EAF0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvErr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#FF7A75"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- دسترسی کنترل -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvAcc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="کنترل از راه دور: غیرفعال"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="برای لمس و تایپ از کروم، سرویس «اشتراک صفحه» را در تنظیمات دسترسی‌پذیری روشن کنید. بدون آن فقط تصویر نمایش داده می‌شود."
                android:textColor="#8B93A4"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnAcc"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_ghost"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="باز کردن تنظیمات دسترسی‌پذیری"
                android:textColor="#E8EAF0"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_btn"
            android:text="شروع اشتراک"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:text="هر دو دستگاه باید به یک وای‌فای (یا هات‌اسپات گوشی) وصل باشند. در کروم بار اول هشدار گواهی نمایش داده می‌شود: «Advanced» و سپس «Proceed» را بزنید. در پنجرهٔ اجازهٔ ضبط، گزینهٔ «کل صفحه» را انتخاب کنید."
            android:textColor="#8B93A4"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
